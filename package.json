{
  "name": "@poweri/poweri-web",
  "version": "0.2.2",
  "description": "PowerI web UI — standalone server (npx @poweri/poweri-web) and the web layer of the PowerI desktop app (fork of pi-web with the PowerI product layer)",
  "homepage": "https://github.com/cgoder/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgoder/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/cgoder/pi-web/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "poweri-web": "poweri/bin/poweri-web.js",
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    "poweri/bin",
    "!poweri/bin/*.test.mjs",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 9989",
    "dev:lan": "next dev -H 0.0.0.0 -p 9989",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 9989",
    "start:lan": "next start -H 0.0.0.0 -p 9989",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"poweri/**/*.test.mjs\" \"public/**/*.test.mjs\"",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public",
    "tauri": "tauri",
    "shell:dev": "vite",
    "shell:build": "vite build",
    "shell:test": "node --experimental-strip-types --test src-tauri/shell/launch-machine.test.ts",
    "desktop:dev": "node scripts/dev-shell.mjs",
    "desktop": "npm run shell:build && tauri build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@tauri-apps/api": "^2.0.0",
    "ansi_up": "^6.0.6",
    "js-yaml": "^5.2.3",
    "next": "16.3.1",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-frontmatter": "^5.0.0",
    "undici": "8.10.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tauri-apps/cli": "^2.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "vite": "^6.0.0"
  }
}
